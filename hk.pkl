/// hk is the ONLY git-hook gate for this repo (CLAUDE.md § hk).
///
/// One definition, two entry points:
///   - git hooks  : `hk install` wires pre-commit / pre-push
///   - manual / CI : `mise run check` -> `hk check` (identical steps)
///
/// Call graph is one direction only: `mise run check` -> `hk check`.
/// hk.pkl NEVER calls back into a mise task (no cycle, CLAUDE.md § mise).
///
/// Layering:
///   pre-commit  fast + side-effect-free : shellcheck, pkl, tofu fmt, cue fmt, ls-lint, ast-grep, kubeconform
///   pre-push    + offline validation    : tofu validate
///   check       + the full test matrix  : tofu test, bats, chainsaw
///                (bats spins real OpenBao/docker daemons, chainsaw needs an
///                 orbstack cluster - too heavy for a file-triggered hook, so
///                 they live in `check` only; chainsaw self-skips with no cluster)
///
/// ls-lint + ast-grep enforce docs/designs/repo-structure.md: directory case
/// and <domain>-<verb>.sh naming (ls-lint, .ls-lint.yml), and forbidden
/// cross-concern path refs in shell (ast-grep, sgconfig.yml + rules/). Both
/// read the whole tree, not a file list — an honestly-scoped lint, not graph
/// analysis (repo-structure.md § Honest scope).
amends "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Builtins.pkl"

/// Fast, deterministic, no daemons. Safe on every commit.
local fast = new Mapping<String, Step> {
  ["shellcheck"] = Builtins.shellcheck
  ["pkl"] {
    // `hk validate` type-checks hk.pkl against its schema without needing a
    // standalone `pkl` CLI. hk.pkl is the only .pkl in the repo.
    glob = List("**/*.pkl")
    check = "hk validate"
  }
  ["tofu-fmt"] {
    glob = List("**/*.tf", "**/*.tftest.hcl")
    check = "tofu fmt -check -recursive {{workspace}}"
    fix = "tofu fmt -recursive {{workspace}}"
    workspace_indicator = "versions.tf"
  }
  ["cue-fmt"] {
    glob = List("**/*.cue")
    // Timoni's vendored schema tree is generated by `timoni mod vendor k8s`,
    // already timoni-formatted — not ours to reformat.
    exclude = List("**/cue.mod/**")
    check = "cue fmt --check {{files}}"
    fix = "cue fmt {{files}}"
  }
  // `timoni mod vet` type-checks the cv_frontend module + its rendered
  // Deployment/Service/SA against the vendored k8s CUE schemas. This is the
  // schema gate for the timoni path — NOT kubeconform (a 2nd validator for
  // one concern; CLAUDE.md § Testing Strategy). Offline, deterministic, no
  // cluster. The glob only gates whether the step runs.
  ["timoni"] {
    glob = List("deploy/frontend/timoni/**")
    check = "timoni mod vet ./deploy/frontend/timoni --name cv-frontend"
  }
  // Structure + naming (docs/designs/repo-structure.md § Enforcement).
  // ls-lint reads names only and validates the whole tree against
  // .ls-lint.yml itself, so it takes no file list.
  ["ls-lint"] = Builtins.ls_lint
  // Forbidden cross-concern path refs in shell (rules/boundary-shell-*,
  // boundary-*-ref) + no `script:` block in a Tekton manifest
  // (rules/boundary-no-embedded-shell.yml, `language: yaml`). `ast-grep
  // scan` reads sgconfig.yml + rules/ and walks the whole tree; the glob
  // only gates whether the step runs when a relevant file changes.
  ["ast-grep"] {
    glob = List(
      "**/*.sh", "**/*.bash", "sgconfig.yml", "rules/**/*.yml",
      "ci/tasks/**/*.yaml", "ci/runtime/**/*.yaml", "ci/pipelines/**/*.yaml"
    )
    allow_binary = true
    allow_symlinks = true
    batch = false
    check = "ast-grep scan"
  }
  // ADR 0018: no OpenTofu `kubernetes_*` / `kubernetes_manifest` resource —
  // OpenTofu owns the substrate, never the cluster's own object graph
  // (in-cluster objects go render→reconcile→enforce→provision). ast-grep
  // ships no HCL grammar (sgconfig.yml), so this is a `git grep` in a tiny
  // guard that classifies match / no-match / grep-error explicitly (a bare
  // `! git grep` inverts a grep ERROR into a green gate). The glob only
  // gates whether the step runs; the script scans the tracked tree.
  ["no-kubernetes-tf"] {
    glob = List("**/*.tf", "tests/check-tf-boundary.sh")
    check = "./tests/check-tf-boundary.sh"
  }
  // Static schema validation of the ci/ Tekton manifests (CLAUDE.md
  // § Testing Strategy — no cluster needed, fast pre-merge gate). A wrapper
  // script: the kubeconform -schema-location template collides with hk's
  // own command templating. Rationale + CRD-schema caveats in the script.
  // The glob only gates whether the step runs.
  ["kubeconform"] {
    glob = List("ci/tasks/**/*.yaml", "ci/runtime/**/*.yaml", "ci/pipelines/**/*.yaml", "ci/tests/crd-schemas/**/*.json", "ci/scripts/kubeconform-scan.sh")
    check = "./ci/scripts/kubeconform-scan.sh"
  }
  // The interim local zot registry manifests (TODOS.md T7b0). All core-API
  // kinds (Namespace/PVC/ConfigMap/Deployment/Service) — the default schema
  // location covers them, so no `-schema-location` template and no wrapper
  // (unlike the ci/ Tekton CRDs above). Inline is safe: no `{{ }}` in the
  // command for hk's templater to choke on.
  ["kubeconform-zot"] {
    glob = List("environments/local/zot/**/*.yaml")
    check = "kubeconform -strict -summary -schema-location default ./environments/local/zot/"
  }
  // The Flux CRs reconciled onto the local cluster (FluxInstance, OCIRepository,
  // HelmRelease, Kustomization). A wrapper script for the same reason as the
  // ci/ Tekton gate — the -schema-location template collides with hk's. CRD
  // schemas vendored at environments/local/flux/tests/crd-schemas/.
  ["kubeconform-flux"] {
    glob = List("environments/local/flux/**/*.yaml", "environments/local/flux/tests/crd-schemas/**/*.json", "environments/local/scripts/flux-kubeconform.sh")
    check = "./environments/local/scripts/flux-kubeconform.sh"
  }
  // The dev-PKI CRs (cert-manager.io/v1 ClusterIssuer + Certificate)
  // reconciled by the `cert-manager-pki` Flux Kustomization — kept out of
  // environments/local/flux/ (and so out of kubeconform-flux) because a
  // whole-Kustomization dry-run fails on an unknown CRD; see
  // environments/local/flux/cert-manager-pki.yaml. Wrapper script for the
  // same -schema-location templating reason as kubeconform-flux.
  ["kubeconform-cert-manager"] {
    glob = List("environments/local/cert-manager/**/*.yaml", "environments/local/cert-manager/tests/crd-schemas/**/*.json", "environments/local/trust-manager/**/*.yaml", "environments/local/scripts/cert-manager-kubeconform.sh")
    check = "./environments/local/scripts/cert-manager-kubeconform.sh"
  }
  // The Kyverno ImageValidatingPolicy (policies.kyverno.io/v1) + its
  // generated approval-pubkey ConfigMap, reconciled by the `kyverno-policy`
  // Flux Kustomization — kept out of environments/local/flux/ for the same
  // unknown-CRD-dry-run reason as cert-manager-pki. The wrapper runs
  // `kustomize build` first (the configMapGenerator reads
  // attestation/cosign-approval.pub in place); the pub key is in the glob so
  // a rotation re-runs the gate.
  ["kubeconform-kyverno"] {
    glob = List("environments/local/kyverno/**/*.yaml", "environments/local/kyverno/tests/crd-schemas/**/*.json", "environments/local/scripts/kyverno-kubeconform.sh", "attestation/cosign-approval.pub")
    check = "./environments/local/scripts/kyverno-kubeconform.sh"
  }
  // The `frontend` Namespace manifest (Plan B M3) reconciled by the
  // `frontend-ns` Flux Kustomization. A core kind — no CRD schema, so
  // inline (no `-schema-location` template to collide with hk's).
  ["kubeconform-frontend"] {
    glob = List("deploy/frontend/k8s/**/*.yaml")
    check = "kustomize build deploy/frontend/k8s | kubeconform -strict -summary -schema-location default -"
  }
}

/// Offline correctness. pre-push and check.
///
/// `tofu-init` is an ordered PREREQUISITE of tofu-validate and tofu-test
/// (CX #8), not a parallel sibling: `tofu validate` needs an initialised
/// workspace, and an unordered init racing the validate/test steps under
/// hk corrupts `.terraform/`. `depends` serialises it; `-backend=false`
/// keeps it offline.
local validate = new Mapping<String, Step> {
  ["tofu-init"] {
    glob = List("**/*.tf", "**/*.tftest.hcl")
    check = "tofu -chdir={{workspace}} init -backend=false -input=false"
    workspace_indicator = "versions.tf"
    exclusive = true
  }
  ["tofu-validate"] {
    glob = List("**/*.tf")
    check = "tofu -chdir={{workspace}} validate"
    workspace_indicator = "versions.tf"
    depends = "tofu-init"
  }
}

/// The full matrix. `hk check` / `mise run check` only - starts real daemons.
local heavy = new Mapping<String, Step> {
  ["tofu-test"] {
    // modules/** for a future published module; environments/** for the
    // in-repo units (the local-OpenBao unit moved here in Phase 2, ADR
    // 0012). `workspace_indicator` scopes each run to one versions.tf dir;
    // `tofu test` in a dir with no tests/ is a clean 0-pass no-op.
    glob = List("modules/**/*.tf", "modules/**/*.tftest.hcl", "environments/**/*.tf", "environments/**/*.tftest.hcl")
    check = "tofu -chdir={{workspace}} test"
    workspace_indicator = "versions.tf"
    depends = "tofu-init"
  }
  // chart-pin gate for environments/local/openbao/ (ADR 0016).
  // `crane digest <tag>` == openbao.lock's chart_digest (the OpenTofu helm
  // provider cannot pin an OCI chart by digest —
  // hashicorp/terraform-provider-helm#1596), then `helm template` BY DIGEST
  // and assert the expected shape. Needs network (crane + helm pull) — like
  // the bats OpenBao suites — and self-skips (exit 0) offline /
  // registry-down, so a flapping registry does not red the check.
  ["openbao-verify"] {
    glob = List(
      "environments/local/openbao/**",
      "environments/local/scripts/openbao-verify.sh"
    )
    check = "./environments/local/scripts/openbao-verify.sh"
  }
  ["bats"] {
    // *.bash (helper.bash) is a fixture, not a suite - excluded
    glob = List("**/tests/*.bats")
    // --print-output-on-failure: on a red case, dump its stdout/stderr so a
    // CI failure names its cause instead of a bare "assertion failed" (T9a).
    // No-op when everything passes.
    check = "bats --print-output-on-failure {{files}}"
  }
  // chainsaw scenarios for the ci/ Tekton defs. [k8s]-gated: the wrapper
  // prints a skip line and exits 0 without an orbstack cluster + Tekton
  // (ci/scripts/tests/helper.bash § [k8s] gate — GitHub runners have no
  // OrbStack, so this must not be fatal in CI, unlike [docker]). The glob
  // only gates whether the step runs; the wrapper globs ci/tests/ itself.
  ["chainsaw"] {
    glob = List(".chainsaw.yaml", "ci/tests/**/*.yaml", "ci/tasks/**/*.yaml", "ci/runtime/**/*.yaml", "ci/scripts/chainsaw-test.sh", "ci/scripts/lib/ci.sh")
    check = "./ci/scripts/chainsaw-test.sh"
  }
  // The environments/local/ Flux setup, server-side. Same [k8s] gate — skips
  // in CI (no OrbStack) and skips locally until `mise run local:flux:bootstrap`
  // has run. Asserts the RUNNING Flux state; does not bootstrap or tear down.
  ["chainsaw-flux"] {
    glob = List(".chainsaw.yaml", "environments/local/tests/flux/**/*.yaml", "environments/local/flux/**/*.yaml", "environments/local/scripts/flux-chainsaw.sh")
    check = "./environments/local/scripts/flux-chainsaw.sh"
  }
  // The in-cluster OpenBao running state (ADR 0016). Same [k8s] gate as
  // chainsaw-flux — skips in CI (no OrbStack) and skips locally until
  // `mise run local:openbao:bootstrap` has deployed it (probe: the
  // `openbao` StatefulSet). Asserts the running state; does not run the
  // bridge or tear down.
  ["chainsaw-openbao"] {
    glob = List(
      ".chainsaw.yaml",
      "environments/local/tests/openbao/**/*.yaml",
      "environments/local/openbao/**",
      "environments/local/cert-manager/**/*.yaml",
      "environments/local/scripts/openbao-chainsaw.sh"
    )
    check = "./environments/local/scripts/openbao-chainsaw.sh"
  }
  // The Kyverno ImageValidatingPolicy running state (Plan B K1, ADR 0020).
  // Same [k8s] gate as chainsaw-flux — skips in CI (no OrbStack) and skips
  // locally until the `kyverno-policy` Flux Kustomization has reconciled the
  // policy (probe: `kubectl get imagevalidatingpolicy frontend-approval`,
  // which is only present post-merge). Asserts admission both ways against
  // real GHCR fixtures; does not install Kyverno or tear down.
  ["chainsaw-kyverno"] {
    glob = List(
      ".chainsaw.yaml",
      "environments/local/tests/kyverno/**/*.yaml",
      "environments/local/kyverno/**/*.yaml",
      "environments/local/flux/kyverno-policy.yaml",
      "environments/local/scripts/kyverno-chainsaw.sh"
    )
    check = "./environments/local/scripts/kyverno-chainsaw.sh"
  }
  // The cv_frontend in-cluster delivery running state (Plan B M3, ADR 0019).
  // Same [k8s] gate — skips in CI and until the `frontend` Flux Kustomization
  // has reconciled (probe: `kubectl get kustomization frontend`, only present
  // post-merge). Asserts DELIVERY (the rendered Deployment runs the approved
  // digest, its container started, the approval policy admitted it), NOT app
  // health — cv_frontend has a known boot crash.
  ["chainsaw-frontend"] {
    glob = List(
      ".chainsaw.yaml",
      "environments/local/tests/frontend/**/*.yaml",
      "environments/local/flux/frontend.yaml",
      "deploy/frontend/k8s/**/*.yaml",
      "deploy/frontend/timoni.lock",
      "environments/local/scripts/frontend-chainsaw.sh"
    )
    check = "./environments/local/scripts/frontend-chainsaw.sh"
  }
  // Silent-coverage-drop guard (F5). Diffs the suites on disk, the
  // committed tests/manifest.txt, and what hk schedules — a mismatch fails
  // the gate. Runs last: it reads `hk check --plan`, it does not re-run
  // the suites.
  ["check-coverage"] {
    glob = List("**/tests/*.bats", "**/*.tftest.hcl", "hk.pkl", "tests/manifest.txt", "tests/check-coverage.sh")
    depends = List("bats", "tofu-test")
    check = "./tests/check-coverage.sh"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fast
  }
  ["pre-push"] {
    steps = (fast) { ["_validate"] = validate }
  }
  ["check"] {
    steps = new Mapping<String, Step> {
      ...fast
      ...validate
      ...heavy
    }
  }
  ["fix"] {
    fix = true
    steps = fast
  }
}
